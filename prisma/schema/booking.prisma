model ReportRented {
  id                String      @id @default(uuid())
  apartmentId       String      @map("apartment_id")
  targetApartmentId String?     @map("target_apartment_id")
  reportType        ReportType  @default(RENT) @map("report_type")
  weekend           DateTime
  paidAt            DateTime?   @map("paid_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  apartment       Apartment            @relation("ApartmentReportRented", fields: [apartmentId], references: [id], onDelete: Cascade)
  targetApartment Apartment?           @relation("SwappedApartment", fields: [targetApartmentId], references: [id], onDelete: SetNull)
  payment         ReportRentedPayment?

  @@map("report_rented")
}
