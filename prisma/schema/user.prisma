model User {
  id           String     @id @default(uuid())
  username     String     @unique
  role         UserRole   @default(USER)
  email        String?    @unique
  phone        String?    @unique
  password     String
  profileImage String?    @map("profile_image")
  status       UserStatus @default(ACTIVE)
  isDeleted    Boolean    @default(false)
  isVerified   Boolean    @default(false)
  otp          Int?       @map("otp")
  otpExpiry    DateTime?  @map("otp_expiry")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  marketingEmail         MarketingEmail?
  apartment              Apartment?
  notifyRequestsSent     NotifyRequest[]           @relation("NotifyRequestUser")
  notifyRequestsRecv     NotifyRequest[]           @relation("NotifyRequestOwner")
  interestedRequestsSent InterestedRequest[]       @relation("InterestedRequestUser")
  interestedRequestsRecv InterestedRequest[]       @relation("InterestedRequestOwner")
  offers                 Offer[]                   @relation("UserOffers")
  reviews                Review[]
  wishlists              Wishlist[]
  bookings               Booking[]                 @relation("UserBookings")
  wallet                 Wallet?
  listingPayment         ApartmentListingPayment?
  bookingPaymentsMade    ApartmentBookingPayment[] @relation("PaymentsGiven")
  bookingPaymentsRecv    ApartmentBookingPayment[] @relation("PaymentsReceived")
  reportRentedPayments   ReportRentedPayment[]     @relation("ReportRentedPayer")
  callsMade              CallLog[]                 @relation("CallsMade")
  callsReceived          CallLog[]                 @relation("CallsReceived")

  @@map("users")
}

model MarketingEmail {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  email        String   @unique
  isSubscribed Boolean  @default(true) @map("is_subscribed")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("marketing_emails")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Float    @default(0.0)
  currency  String   @default("ILS")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String          @map("wallet_id")
  amount      Float
  type        TransactionType
  description String?
  referenceId String?         @map("reference_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}
