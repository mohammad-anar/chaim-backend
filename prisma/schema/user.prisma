model User {
  id           String     @id @default(uuid())
  username     String     @unique
  role         UserRole   @default(USER)
  email        String?    @unique
  phone        String?    @unique
  password     String
  profileImage String?    @map("profile_image")
  status       UserStatus @default(ACTIVE)
  isDeleted    Boolean    @default(false)
  isVerified   Boolean    @default(false)
  otp          Int?       @map("otp")
  otpExpiry    DateTime?  @map("otp_expiry")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  marketingPlatformId    String?                   @map("marketing_platform_id")
  marketingPlatform      MarketingPlatform?        @relation(fields: [marketingPlatformId], references: [id], onDelete: SetNull)

  marketingEmail                MarketingEmail?
  ownerNotificationPreference   OwnerNotificationPreference?
  apartment                     Apartment?
  notifyRequestsSent     NotifyRequest[]           @relation("NotifyRequestUser")
  notifyRequestsRecv     NotifyRequest[]           @relation("NotifyRequestOwner")
  interestedRequestsSent InterestedRequest[]       @relation("InterestedRequestUser")
  interestedRequestsRecv InterestedRequest[]       @relation("InterestedRequestOwner")
  offers                 Offer[]                   @relation("UserOffers")
  reviews                Review[]
  wishlists              Wishlist[]
  listingPayment         ApartmentListingPayment?
  reportRentedPayments   ReportRentedPayment[]     @relation("ReportRentedPayer")
  swapPayments           SwapPayment[]             @relation("SwapPayer")
  callsMade              CallLog[]                 @relation("CallsMade")
  callsReceived          CallLog[]                 @relation("CallsReceived")

  @@map("users")
}

model MarketingEmail {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  email        String   @unique
  isSubscribed Boolean  @default(true) @map("is_subscribed")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("marketing_emails")
}

model OwnerNotificationPreference {
  id                String                 @id @default(uuid())
  userId            String                 @unique @map("user_id")
  channel           NotificationPreference @default(EMAIL)
  notificationEmail String?                @map("notification_email")
  notificationPhone String?                @map("notification_phone")
  preferredDay      DayOfWeek?             @map("preferred_day")
  preferredTime     String?                @map("preferred_time") // e.g. "09:00"
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_notification_preferences")
}
