NODE_ENV=production
PORT=5000
IP_ADDRESS=127.0.0.1

DATABASE_URL="postgresql://postgres:password@host:5432/dbname?schema=public"
REDIS_URL="redis://localhost:6379"

BCRYPT_SALT_ROUND=10
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT Secrets
JWT_SECRET=your_jwt_secret
JWT_EXPIRE_IN=1d
JWT_REFRESH_EXPIRE_IN=30d

# Email Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_FROM=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Super Admin Seed Details
NAME=Admin
EMAIL=admin@gmail.com
PHONE=01457385594
PASSWORD=your_admin_password
AVATAR=https://i.ibb.co/VWkMFBWM/pngtree-user-icon-png-image-1796659.jpg

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=ILS

# Platform Fees (in ILS)
APARTMENT_LISTING_FEE=100
REPORT_RENTED_FEE=50