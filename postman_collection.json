          "name": "Get My Swap Preference",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/swap-preference/my-preference", "host": ["{{baseUrl}}"], "path": ["swap-preference", "my-preference"] }
          }
        },
        {
          "name": "Get Matched Swappable Properties (Swap Gated)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/swap-preference/matched-swaps?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["swap-preference", "matched-swaps"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
