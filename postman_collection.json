            "url": {
              "raw": "{{baseUrl}}/apartment/all?city=Jerusalem&neighborhood=Rehavia&bedrooms=3&bathrooms=2&minPrice=100&maxPrice=1000&propertyType=Penthouse&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["apartment", "all"],
              "query": [
                { "key": "city", "value": "Jerusalem" },
                { "key": "neighborhood", "value": "Rehavia" },
                { "key": "bedrooms", "value": "3" },
                { "key": "bathrooms", "value": "2" },
