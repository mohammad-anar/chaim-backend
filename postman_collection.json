{
  "info": {
    "_postman_id": "chaim-backend-api-collection",
    "name": "Chaim Backend API Collection",
    "description": "Complete Postman collection for Chaim Backend API covering all 17 feature modules with dynamic variables, authentication, search/filters, and sample payloads.",
