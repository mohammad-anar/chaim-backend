          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/weekend-calendar/{{shabbosId}}", "host": ["{{baseUrl}}"], "path": ["weekend-calendar", "{{shabbosId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Apartment Availability",
      "item": [
        {
          "name": "Add Availability",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apartmentId\": \"{{apartmentId}}\",\n  \"weekendId\": \"{{shabbosId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/apartment-availability/add", "host": ["{{baseUrl}}"], "path": ["apartment-availability", "add"] }
          }
        },
        {
          "name": "Remove Availability",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apartmentId\": \"{{apartmentId}}\",\n  \"weekendId\": \"{{shabbosId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/apartment-availability/remove", "host": ["{{baseUrl}}"], "path": ["apartment-availability", "remove"] }
          }
        },
        {
          "name": "Bulk Set Availability",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apartmentId\": \"{{apartmentId}}\",\n  \"weekendIds\": [\"{{shabbosId}}\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/apartment-availability/bulk-set", "host": ["{{baseUrl}}"], "path": ["apartment-availability", "bulk-set"] }
          }
        },
        {
          "name": "Get Apartment Availabilities",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/apartment-availability/{{apartmentId}}", "host": ["{{baseUrl}}"], "path": ["apartment-availability", "{{apartmentId}}"] }
          }
        }
      ]
    },
    {
      "name": "6. Payment",
      "item": [
        {
          "name": "Create Listing Payment Intent (100 ILS)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apartmentId\": \"{{apartmentId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payment/create-listing-intent", "host": ["{{baseUrl}}"], "path": ["payment", "create-listing-intent"] }
          }
        },
        {
          "name": "Verify Payment Intent (Stripe Verification)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"pi_3MtwBwLkdIwHu7ix08a2k05d\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payment/verify-intent", "host": ["{{baseUrl}}"], "path": ["payment", "verify-intent"] }
          }
        }
      ]
    },
    {
      "name": "7. Swap Preference",
      "item": [
        {
          "name": "Turn On / Update Swap Preference",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isEnabled\": true,\n  \"city\": \"Tel Aviv\",\n  \"neighborhood\": \"Florentin\",\n  \"rooms\": 3,\n  \"beds\": 2,\n  \"weekend\": \"2026-10-17T00:00:00.000Z\",\n  \"whatsApp\": \"+972501234567\",\n  \"email\": \"david@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/swap-preference", "host": ["{{baseUrl}}"], "path": ["swap-preference"] }
          }
        },
        {
          "name": "Turn Off Swap Preference",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isEnabled\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/swap-preference", "host": ["{{baseUrl}}"], "path": ["swap-preference"] }
          }
        },
