{
  "info": {
    "_postman_id": "chaim-backend-api-collection",
    "name": "Chaim Backend API Collection",
    "description": "Complete Postman collection for Chaim Backend API covering all feature modules with dynamic variables, authentication, search/filters, swap gating, dual-fee swap report rented, and sample payloads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "apartmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetApartmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shabbosId",
      "value": "",
      "type": "string"
    },
    {
      "key": "swapId",
      "value": "",
      "type": "string"
    },
    {
      "key": "offerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"david_cohen\",\n  \"email\": \"david@example.com\",\n  \"phone\": \"+972501234567\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"david@example.com\",\n  \"otp\": 123456\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth", "verify-otp"] }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"david@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["auth", "resend-otp"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "}",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"12345678\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookies", "value": "refreshToken={{refreshToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"david@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"david@example.com\",\n  \"otp\": 123456,\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] }
          }
        }
      ]
    },
    {
      "name": "2. User",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/user/me", "host": ["{{baseUrl}}"], "path": ["user", "me"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"david_cohen_updated\",\n  \"phone\": \"+972509876543\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/user/update-me", "host": ["{{baseUrl}}"], "path": ["user", "update-me"] }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/user/user-id-here", "host": ["{{baseUrl}}"], "path": ["user", "user-id-here"] }
          }
        },
        {
          "name": "Admin: Get All Users",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/user?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["user"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Admin: Update User Status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/user/status/user-id-here", "host": ["{{baseUrl}}"], "path": ["user", "status", "user-id-here"] }
          }
        },
        {
          "name": "Admin: Delete User",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/user/user-id-here", "host": ["{{baseUrl}}"], "path": ["user", "user-id-here"] }
          }
        }
      ]
    },
    {
      "name": "3. Apartment",
      "item": [
        {
          "name": "Create Apartment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('apartmentId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Luxury Penthouse in Jerusalem\",\n  \"description\": \"Beautiful 3-bedroom apartment close to the Western Wall with city view.\",\n  \"city\": \"Jerusalem\",\n  \"neighborhood\": \"Rehavia\",\n  \"street1\": \"King George St 12\",\n  \"propertyType\": \"PENTHOUSE\",\n  \"bedrooms\": 3,\n  \"bathrooms\": 2,\n  \"maxGuest\": 6,\n  \"pricePerShabbat\": 450,\n  \"amenities\": [\"WIFI\", \"KOSHER_KITCHEN\", \"AIR_CONDITIONING\", \"SHABBAT_ELEVATOR\"],\n  \"howToContact\": \"BOTH\",\n  \"phoneNumber\": \"+972501234567\",\n  \"whatsApp\": \"+972501234567\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/apartment", "host": ["{{baseUrl}}"], "path": ["apartment"] }
          }
        },
        {
          "name": "Get All Apartments (Search & Filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/apartment?city=Jerusalem&neighborhood=Rehavia&bedrooms=3&bathrooms=2&minPrice=100&maxPrice=1000&propertyType=PENTHOUSE&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["apartment"],
              "query": [
                { "key": "city", "value": "Jerusalem" },
                { "key": "neighborhood", "value": "Rehavia" },
                { "key": "bedrooms", "value": "3" },
                { "key": "bathrooms", "value": "2" },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "1000" },
                { "key": "propertyType", "value": "PENTHOUSE" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get My Apartment",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/apartment/my-apartment", "host": ["{{baseUrl}}"], "path": ["apartment", "my-apartment"] }
          }
        },
        {
          "name": "Get Apartment By ID / Property ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/apartment/{{apartmentId}}", "host": ["{{baseUrl}}"], "path": ["apartment", "{{apartmentId}}"] }
          }
        },
        {
          "name": "Update Apartment",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerShabbat\": 500,\n  \"description\": \"Updated luxury penthouse description with added Shabbat amenities.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/apartment/{{apartmentId}}", "host": ["{{baseUrl}}"], "path": ["apartment", "{{apartmentId}}"] }
          }
        },
        {
          "name": "Admin: Get Apartment Details",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/apartment/admin-details/{{apartmentId}}", "host": ["{{baseUrl}}"], "path": ["apartment", "admin-details", "{{apartmentId}}"] }
          }
        },
        {
          "name": "Admin: Update Apartment Status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/apartment/status/{{apartmentId}}", "host": ["{{baseUrl}}"], "path": ["apartment", "status", "{{apartmentId}}"] }
          }
        },
        {
          "name": "Delete Apartment",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/apartment/{{apartmentId}}", "host": ["{{baseUrl}}"], "path": ["apartment", "{{apartmentId}}"] }
          }
        }
      ]
    },
    {
